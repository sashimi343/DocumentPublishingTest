{
  "metadata": [
    {
      "src": [{ "src": "../obj/docs/staging/en", "files": ["*.dll"] }],
      "dest": "../docs/en/api"
    }
  ],
  "build": {
    "content": [{ "src": "../docs/en", "files": ["**/*.md", "**/*.yml"] }],
    "resource": [{ "files": ["images/**"] }],
    "output": "../_site/en",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "DocumentPublishingTest (en)",
      "_appName": "DocumentPublishingTest",
      "_appLogoPath": "images/logo.svg",
      "_appFooter": "Copyright &copy; 2026 Kohei Kakimoto",
      "_lang": "en",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
